{
    "$schema": "https://raw.githubusercontent.com/infection/infection/0.32.3/resources/schema.json",
    "source": {
        "directories": ["."],
        "excludes": ["tests", "lang", "db", "version.php", ".github"]
    },
    "mutators": {"@default": true},
    "phpUnit": {
        "configDir": "../../..",
        "customPath": "../../../vendor/bin/phpunit"
    },
    "initialTestsPhpOptions": "-dxdebug.mode=off -dpcov.enabled=1 -dpcov.directory=.",
    "bootstrap": "../../../vendor/autoloadmoodle.php",
    "logs": {
        "text": "infection.log",
        "summary": "infection-summary.log"
    }
}
